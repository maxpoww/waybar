{
  "layer": "top",
  "position": "top",
  "height": 88,
  "margin-top": 95,
  "margin-left": 189,
  "exclusive": false,
  "passthrough": false,
  "gtk-layer-shell": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/app0",
    "custom/app1",
    "custom/app2",
    "custom/app3",
    "custom/app4",
    "custom/app5",
    "custom/app6",
    "custom/app7",
    "custom/app8",
    "custom/app9",
    "custom/add"
  ],
  "modules-center": [],
  "modules-right": [],
  "custom/app0": {
    "exec": "/home/max/.config/waybar/offers/empty-dock/launch-app.sh firefox Firefox --print-icon ",
    "return-type": "json",
    "interval": "once",
    "on-click": "/home/max/.config/waybar/offers/empty-dock/launch-app.sh firefox Firefox",
    "on-click-right": "/home/max/.config/waybar/offers/empty-dock/context-menu.sh 0"
  },
  "custom/app1": {
    "exec": "/home/max/.config/waybar/offers/empty-dock/launch-app.sh kitty Terminal --print-icon ",
    "return-type": "json",
    "interval": "once",
