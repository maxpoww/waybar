    "return-type": "json",
    "interval": "once",
    "on-click": "/home/max/.config/waybar/offers/empty-dock/launch-app.sh code Code",
    "on-click-right": "/home/max/.config/waybar/offers/empty-dock/context-menu.sh 3"
  },
