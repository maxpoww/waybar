  "custom/add": {
    "exec": "echo '{\"text\":\" +\",\"tooltip\":\"Add app\"}'",
    "return-type": "json",
    "interval": "once",
    "on-click": "/home/max/.config/waybar/offers/empty-dock/add-app.sh"
  }
