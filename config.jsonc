{
  "exclusive": true,
  "spacing": 4,
  "modules-left": [
    "group/workspaces",
    "group/active-window",
    "custom/kitty"
  ],
  "modules-center": [
    "group/group-rofi",
    "custom/window",
    "custom/x"
  ],
  "modules-right": [
    "tray",
    "group/group-2",
    "group/group-power",
    "custom/clock",
    "custom/battery",
    "group/screen-type-group"
  ],
  "tray": {
    "icon-size": 21,
    "spacing": 10,
    "show-passive-items": true,
    "reverse-direction": false
  },
  "custom/kitty": {
    "exec": "~/kitty.sh",
    "interval": 1,
    "return-type": "json",
    "format": " ",
    "on-click": "kitty"
  },
  "group/active-window": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/win-icon",
      "custom/win-close",
      "custom/win-minimize",
      "group/win-move"
    ]
  },
  "custom/win-icon": {
    "exec": "~/.config/waybar/scripts/win-icon.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/win-action.sh new-instance"
  },
  "custom/win-close": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰅖\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch killactive"
  },
  "custom/win-minimize": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰘑\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace special"
  },
  "group/win-move": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/win-move-trigger",
      "custom/win-move-1",
      "custom/win-move-2",
      "custom/win-move-3",
      "custom/win-move-4",
      "custom/win-move-5",
      "custom/win-move-6",
      "custom/win-move-7",
      "custom/win-move-8",
      "custom/win-move-9",
      "custom/win-move-new"
    ]
  },
  "custom/win-move-trigger": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰁁\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false
  },
  "custom/win-move-1": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(1)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"1\" ]; then printf '{\"text\":\"1\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"1\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 1"
  },
  "custom/win-move-2": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(2)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"2\" ]; then printf '{\"text\":\"2\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"2\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 2"
  },
  "custom/win-move-3": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(3)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"3\" ]; then printf '{\"text\":\"3\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"3\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 3"
  },
  "custom/win-move-4": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(4)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"4\" ]; then printf '{\"text\":\"4\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"4\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 4"
  },
  "custom/win-move-5": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(5)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"5\" ]; then printf '{\"text\":\"5\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"5\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 5"
  },
  "custom/win-move-6": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(6)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"6\" ]; then printf '{\"text\":\"6\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"6\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 6"
  },
  "custom/win-move-7": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(7)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"7\" ]; then printf '{\"text\":\"7\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"7\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 7"
  },
  "custom/win-move-8": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(8)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"8\" ]; then printf '{\"text\":\"8\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"8\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 8"
  },
  "custom/win-move-9": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(9)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"9\" ]; then printf '{\"text\":\"9\",\"class\":\"%s current\"}' \"$m\"; else printf '{\"text\":\"9\",\"class\":\"%s\"}' \"$m\"; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace 9"
  },
  "custom/win-move-new": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"+\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch movetoworkspace empty"
  },
  "group/screen-type-group": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/screen-type",
      "custom/screen-type-newspaper",
      "custom/screen-type-paper",
      "custom/screen-type-eye",
      "custom/screen-type-cinema",
      "custom/screen-type-full",
      "custom/screen-type-dark-real",
      "custom/screen-type-dark-warm"
    ]
  },
  "custom/screen-type": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); ~/.config/waybar/scripts/screen-type.sh status | jq -c --arg m \"$m\" '.class = $m'",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/screen-type.sh next && pkill -RTMIN+10 waybar",
    "on-click-right": "~/.config/waybar/scripts/screen-type.sh prev && pkill -RTMIN+10 waybar",
    "format": "{}",
    "tooltip": true
  },
  "custom/screen-type-full": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰃞\",\"class\":\"%s\",\"tooltip\":\"Full: Maximum brightness and neutral color. Hardware at its best.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set full && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-eye": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󱄴\",\"class\":\"%s\",\"tooltip\":\"Eye Protection: Scientifically optimal settings for long-term eye health during extended screen use.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set eye && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-cinema": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰯜\",\"class\":\"%s\",\"tooltip\":\"Cinema: Warm, dim display. Comfortable for watching video in a dark room.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set cinema && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-dark-real": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰃟\",\"class\":\"%s\",\"tooltip\":\"Dark Real Colors: Minimum brightness, neutral color. Night use without color distortion.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set dark-real && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-dark-warm": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰃠\",\"class\":\"%s\",\"tooltip\":\"Dark Warm: Minimum brightness, very warm color. Circadian-friendly night mode.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set dark-warm && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-paper": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󱉟\",\"class\":\"%s\",\"tooltip\":\"Paper: Cream-warm tint with grain. Makes reading feel like a physical page.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set paper && pkill -RTMIN+10 waybar"
  },
  "custom/screen-type-newspaper": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰦩\",\"class\":\"%s\",\"tooltip\":\"Newspaper: Greyscale with halftone grain and aged-white tint. Printed newspaper feel.\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/screen-type.sh set newspaper && pkill -RTMIN+10 waybar"
  },
  "group/group-rofi": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/new",
      "custom/hidden"
    ]
  },
  "custom/new": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/hidden": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/x": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"⧉\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "~/new.sh"
  },
  "group/group-2": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/tools",
      "group/group-blue",
      "group/group-wifi"
    ]
  },
  "group/group-blue": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/blue",
      "custom/kill",
      "custom/scan",
      "custom/more"
    ]
  },
  "custom/blue": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
