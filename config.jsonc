  },
  "custom/more2": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/reboot",
      "custom/lock"
    ]
  },
  "custom/reboot": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰜉\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "reboot"
  },
  "custom/lock": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰍁\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/power": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "systemctl hibernate"
  },
  "height": 26,
  "group/workspaces": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/ws-current",
      "custom/ws-1",
      "custom/ws-2",
      "custom/ws-3",
      "custom/ws-4",
      "custom/ws-5",
      "custom/ws-6",
      "custom/ws-7",
      "custom/ws-8",
      "custom/ws-9"
    ]
  },
  "custom/ws-current": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); printf '{\"text\":\"%s\",\"class\":\"%s\"}' \"$ws\" \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace empty"
  },
  "custom/ws-1": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(1)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"1\" ]; then printf '{\"text\":\"1\",\"class\":\"%s\"}' \"$m\"; else printf '{\"text\":\"1\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 1"
  },
  "custom/ws-2": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(2)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"2\" ]; then printf '{\"text\":\"2\",\"class\":\"%s\"}' \"$m\"; else printf '{\"text\":\"2\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 2"
  },
  "custom/ws-3": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(3)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"3\" ]; then printf '{\"text\":\"3\",\"class\":\"%s\"}' \"$m\"; else printf '{\"text\":\"3\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 3"
  },
