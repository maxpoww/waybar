    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); a=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id'); e=$(hyprctl workspaces -j 2>/dev/null | jq '[.[].id] | index(4)'); [ -z \"$e\" ] || [ \"$e\" = \"null\" ] && exit 0; if [ \"$a\" = \"4\" ]; then printf '{\"text\":\"4\",\"class\":\"%s\"}' \"$m\"; else printf '{\"text\":\"4\",\"class\":\"inactive\"}'; fi",
    "return-type": "json",
