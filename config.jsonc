    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false
  },
  "group/group-wifi": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/wifi",
      "custom/kill2",
      "custom/scan2",
      "custom/more2"
    ]
  },
  "custom/wifi": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰖩\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "rofi -show drun"
  },
  "custom/kill2": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰖪\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
