    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/power",
      "custom/reboot",
      "custom/lock"
    ]
  },
  "custom/reboot": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰜉\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "reboot"
  },
  "custom/lock": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"󰍁\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "swaylock"
  },
  "custom/power": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"\",\"class\":\"%s\"}' \"$m\"",
    "return-type": "json",
    "format": "{}",
    "interval": "once",
    "signal": 10,
    "tooltip": false,
    "on-click": "systemctl hibernate"
  },
  "height": 26,
  "group/workspaces": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/ws-current",
      "custom/ws-1",
      "custom/ws-2",
      "custom/ws-3",
      "custom/ws-4",
      "custom/ws-5",
      "custom/ws-6",
      "custom/ws-7",
      "custom/ws-8",
      "custom/ws-9"
    ]
  },
  "custom/ws-current": {
    "exec": "cat /tmp/waybar-cache/ws-current 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace empty"
  },
  "custom/ws-1": {
    "exec": "cat /tmp/waybar-cache/ws-1 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 1"
  },
  "custom/ws-2": {
    "exec": "cat /tmp/waybar-cache/ws-2 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 2"
  },
  "custom/ws-3": {
    "exec": "cat /tmp/waybar-cache/ws-3 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 3"
  },
  "custom/ws-4": {
    "exec": "cat /tmp/waybar-cache/ws-4 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 4"
  },
  "custom/ws-5": {
    "exec": "cat /tmp/waybar-cache/ws-5 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 5"
  },
  "custom/ws-6": {
    "exec": "cat /tmp/waybar-cache/ws-6 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 6"
  },
  "custom/ws-7": {
    "exec": "cat /tmp/waybar-cache/ws-7 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 7"
  },
  "custom/ws-8": {
    "exec": "cat /tmp/waybar-cache/ws-8 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 8"
  },
  "custom/ws-9": {
    "exec": "cat /tmp/waybar-cache/ws-9 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 10,
    "tooltip": false,
    "on-click": "hyprctl dispatch workspace 9"
  },
  "custom/clock": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); printf '{\"text\":\"%s\",\"class\":\"%s\",\"tooltip\":\"%s\"}' \"$(TZ=America/Mendoza date +%H:%M)\" \"$m\" \"$(TZ=America/Mendoza date +%Y\\ %B)\"",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "signal": 10,
    "tooltip": true
  },
  "custom/battery": {
    "exec": "m=$(cat /tmp/glass-mode 2>/dev/null || echo dark); cap=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo \"?\"); st=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo Unknown); if [ \"$st\" = \"Charging\" ]; then icon=\"\"; elif [ \"$st\" = \"Full\" ]; then icon=\"\"; elif [ \"$cap\" -le 15 ] 2>/dev/null; then icon=\"\"; else icon=\"󰠠\"; fi; printf '{\"text\":\"%s\",\"class\":\"%s\",\"tooltip\":\"%s%% %s\"}' \"$icon\" \"$m\" \"$cap\" \"$st\"",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "signal": 10,
    "tooltip": true
  },
  "custom/window": {
    "exec": "cat /tmp/waybar-cache/window 2>/dev/null",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "signal": 10,
    "tooltip": false,
    "on-click": "rofi -show window"
  }
}
